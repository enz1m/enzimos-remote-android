<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for WebSocket signaling and WebRTC -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- mDNS discovery requires WiFi multicast -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Foreground service for active streaming (prevents process kill) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Opt-in: text messages on computers (Settings). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Keeps file transfers running when the app leaves the screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Find my phone: the "Found it" screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Screen mirroring and webcam to the computer. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Wake lock for keeping CPU active during streaming -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Haptic feedback for touch input -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Camera for QR code scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera is optional: only needed for QR pairing, not for streaming.
         Mark as not required so the app is available on devices without a camera
         (e.g. ChromeOS without a camera). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".RemoteApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Enzremote"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AddComputerActivity"
            android:exported="false"
            android:label="@string/add_title" />

        <activity
            android:name=".StreamActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Enzremote.Stream" />

        <activity
            android:name=".PairingActivity"
            android:exported="false"
            android:label="@string/pairing_title"
            android:theme="@style/Theme.Enzremote.Fullscreen" />

        <activity
            android:name=".remote.RemoteControlActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="Settings" />

        <!-- "Share" from any app: files go to a computer, text to its clipboard. -->
        <activity
            android:name=".share.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.Enzremote.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Notification mirroring; also keeps computer links up in the background. -->
        <service
            android:name=".phone.NotificationMirror"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".phone.FindPhone$StopReceiver"
            android:exported="false" />

        <activity
            android:name=".phone.FindPhone$FoundItActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <service
            android:name=".uplink.UplinkService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|camera" />

        <service
            android:name=".uplink.MirrorControl"
            android:exported="true"
            android:label="@string/mirror_control_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mirror_control" />
        </service>

        <service
            android:name=".share.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
