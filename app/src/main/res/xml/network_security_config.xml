<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release: require TLS for all connections.
         Debug builds override this via src/debug/res/xml/ to allow
         cleartext for LAN development. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
