<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 11 and below.
    Disallow all backup since this app stores sensitive auth tokens.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
