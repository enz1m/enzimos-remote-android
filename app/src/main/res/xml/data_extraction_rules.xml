<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+.
    Disallow cloud backup and device transfer of app data since
    this app stores sensitive auth tokens.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
