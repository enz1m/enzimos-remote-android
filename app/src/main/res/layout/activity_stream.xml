<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:context=".StreamActivity">

    <!-- Stream chrome stays inside status-bar, cutout and keyboard safe areas. -->
    <FrameLayout
        android:id="@+id/streamContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/black">

            <com.enzimos.remote.video.StreamSurfaceView
                android:id="@+id/surfaceVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:contentDescription="@string/cd_remote_desktop_stream" />

            <!-- On-screen game controller (per-app setting) -->
            <com.enzimos.remote.ui.GamepadOverlayView
                android:id="@+id/gamepadOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Long-press progress indicator (radial arc during hold) -->
            <com.enzimos.remote.input.LongPressIndicatorView
                android:id="@+id/longPressIndicator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/overlayConnecting"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:background="@color/overlay_background"
                android:clickable="true"
                android:visibility="visible">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressConnecting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="@android:color/transparent"
                    app:indicatorSize="48dp" />

                <TextView
                    android:id="@+id/tvOverlayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/status_connecting"
                    android:textColor="@android:color/white"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="@string/action_retry"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDisconnect"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/remote_home"
                        android:textColor="@android:color/white"
                        app:strokeColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>

            <com.enzimos.remote.video.VideoCornerMask
                android:id="@+id/videoCorners"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <include android:id="@+id/streamDock" layout="@layout/view_stream_dock" />
        </LinearLayout>

        <!-- Top toolbar overlay (auto-hides) -->
        <LinearLayout
            android:id="@+id/toolbarOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/overlay_background"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/cd_disconnect"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStreamHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    tools:text="192.0.2.20:9470" />

                <TextView
                    android:id="@+id/tvStreamSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/toolbar_text_secondary"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    tools:text="Session: demo-1234" />
            </LinearLayout>

            <!-- App switch button -->
            <ImageView
                android:id="@+id/btnSwitchApp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="@string/cd_switch_app"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- Keyboard toggle button -->
            <ImageView
                android:id="@+id/btnKeyboard"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="@string/cd_toggle_keyboard"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <!-- RTT/latency indicator -->
            <TextView
                android:id="@+id/tvRtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/toolbar_text_secondary"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:fontFamily="monospace"
                tools:text="5ms" />
        </LinearLayout>

        <!-- Performance overlay (dev mode) -->
        <TextView
            android:id="@+id/tvPerfOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@color/perf_overlay_bg"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="@color/perf_overlay_text"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="FPS: 30\nRTT: 5ms\nDecode: 3ms" />
    </FrameLayout>

    <!-- ═══ App Drawer (right-edge swipe) ═══ -->
    <LinearLayout
        android:id="@+id/appDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/drawer_background"
        android:clickable="true"
        android:focusable="true">

        <!-- Running Apps section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/drawer_running_apps"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:paddingBottom="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/drawer_divider" />

        <!-- Running windows list (takes remaining space) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvDrawerEmptyWindows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drawer_no_windows"
                android:textSize="14sp"
                android:textColor="@color/drawer_hint_text"
                android:padding="16dp"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDrawerWindows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Launch App section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/drawer_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/drawer_launch_app"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawerLaunchers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
