<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationContentDescription="@string/action_back"
        tools:title="laptopA1" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabMedia"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remote_tab_media" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabTouchpad"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remote_tab_touchpad" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tabPresenter"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/remote_tab_presenter" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Media -->
        <LinearLayout
            android:id="@+id/mediaPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="28dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/remote_album_art"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/artPlaceholder"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_music_note"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/mediaTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                tools:text="Returns" />

            <TextView
                android:id="@+id/mediaArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Artist" />

            <com.google.android.material.slider.Slider
                android:id="@+id/seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/remote_seek"
                android:valueFrom="0"
                android:valueTo="1"
                app:labelBehavior="gone" />

            <LinearLayout
                android:id="@+id/timeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    tools:text="1:02" />

                <TextView
                    android:id="@+id/length"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    tools:text="3:45" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/previous"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/remote_previous"
                    app:icon="@drawable/ic_skip_previous"
                    app:iconSize="36dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/playPause"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginHorizontal="20dp"
                    android:contentDescription="@string/remote_play_pause"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="44dp"
                    app:icon="@drawable/ic_play"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="44dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@string/remote_next"
                    app:icon="@drawable/ic_skip_next"
                    app:iconSize="36dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/mute"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/remote_mute"
                    app:icon="@drawable/ic_volume" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/remote_volume"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="150"
                    app:labelBehavior="floating"
                    app:tickVisible="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/player"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                tools:text="Firefox ▾" />
        </LinearLayout>

        <!-- Touchpad -->
        <LinearLayout
            android:id="@+id/touchpadPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <com.enzimos.remote.remote.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_touchpad" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leftButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/remote_left_click" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rightButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/remote_right_click" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Presenter -->
        <LinearLayout
            android:id="@+id/presenterPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slideNext"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:text="@string/remote_next_slide"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_skip_next"
                app:iconGravity="textTop"
                app:iconSize="48dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/slidePrevious"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:text="@string/remote_previous_slide"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_skip_previous"
                app:iconGravity="textStart" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slideStart"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/remote_start_show" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slideBlack"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:text="@string/remote_black_screen" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/slideEnd"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="@string/remote_end_show" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/laser"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="12dp"
                android:text="@string/remote_laser"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_laser"
                app:iconGravity="textStart" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/remote_presenter_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>

    <com.enzimos.remote.remote.KeyCatcherView
        android:id="@+id/keyCatcher"
        android:layout_width="1dp"
        android:layout_height="1dp" />
</LinearLayout>
