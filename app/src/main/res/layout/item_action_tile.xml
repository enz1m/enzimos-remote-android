<?xml version="1.0" encoding="utf-8"?>
<!-- One round quick action: icon in a tonal circle, short label below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_tile_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:minHeight="48dp"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <View
            android:id="@+id/pulse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_action_pulse"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_action_circle"
            android:importantForAccessibility="no"
            android:padding="12dp"
            app:tint="?attr/colorOnSecondaryContainer"
            tools:src="@drawable/ic_remote" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurface"
        tools:text="Remote" />
</LinearLayout>
