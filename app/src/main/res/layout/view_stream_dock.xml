<?xml version="1.0" encoding="utf-8"?>
<!-- Floating toolbar: icon actions, labels in tooltips and accessibility. -->
<com.enzimos.remote.video.StreamDock
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="28dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dockHome"
                style="@style/Widget.EnzRemote.DockButton"
                android:contentDescription="@string/dock_home_description"
                android:tooltipText="@string/dock_home_description"
                app:icon="@drawable/ic_remote_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dockKeyboard"
                style="@style/Widget.EnzRemote.DockButton"
                android:contentDescription="@string/show_keyboard"
                android:tooltipText="@string/show_keyboard"
                app:icon="@drawable/ic_remote_keyboard" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dockSettings"
                style="@style/Widget.EnzRemote.DockButton"
                android:contentDescription="@string/app_settings"
                android:tooltipText="@string/app_settings"
                app:icon="@drawable/ic_remote_tune" />

            <View
                android:id="@+id/dockDivider"
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dockClose"
                style="@style/Widget.EnzRemote.DockButton"
                android:contentDescription="@string/dock_close_description"
                android:tooltipText="@string/dock_close_description"
                app:iconTint="?attr/colorError"
                app:rippleColor="?attr/colorErrorContainer"
                app:icon="@drawable/ic_remote_close" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.enzimos.remote.video.StreamDock>
