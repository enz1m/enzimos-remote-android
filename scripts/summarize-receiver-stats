#!/usr/bin/env python3
"""Summarize debug receiver_stats logs without mistaking RTT for end-to-end latency."""
import argparse
import json
import math
import re
import statistics
from pathlib import Path


def summarize(text):
    rows = []
    fields = ("fps", "kbps", "loss", "rtt_ms", "decode_ms", "jitter_buffer_ms")
    recovery = ("dropped_frames", "nacks", "plis", "retransmissions", "freezes", "freeze_ms")
    for line in text.splitlines():
        if "receiver_stats " not in line:
            continue
        values = dict(re.findall(r"(\w+)=(-?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)", line.split("receiver_stats ", 1)[1]))
        try:
            row = {field: float(values[field]) for field in fields}
        except (ValueError, KeyError):
            continue
        if all(math.isfinite(value) and value >= 0 for value in row.values()):
            for field in recovery:
                if field in values:
                    value = float(values[field])
                    if math.isfinite(value) and value >= 0:
                        row[field] = value
            rows.append(row)
    def metric(field):
        values = sorted(row[field] for row in rows)
        if not values:
            return None
        def percentile(fraction):
            return values[min(len(values) - 1, max(0, math.ceil(len(values) * fraction) - 1))]
        return {"mean": round(statistics.fmean(values), 3), "p50": round(percentile(.50), 3),
                "p95": round(percentile(.95), 3), "min": round(values[0], 3), "max": round(values[-1], 3)}
    return {"measurement": "video receiver interval stats; not touch-to-photon",
            "samples": len(rows), "zero_frame_samples": sum(row["fps"] == 0 for row in rows),
            "metrics": {field: metric(field) for field in fields},
            "recovery": {field: {"available_samples": sum(field in row for row in rows),
                                  "total": round(sum(row[field] for row in rows if field in row), 3)}
                         if any(field in row for row in rows) else None for field in recovery}}


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("log", type=Path)
    args = parser.parse_args()
    print(json.dumps(summarize(args.log.read_text()), indent=2))
